# Copy this file to .env and fill in real values.
# Never commit the actual .env file to version control.

# ── Required ──────────────────────────────────────────────────────────────────
APP_JWT_SECRET=replace-with-a-long-random-secret-at-least-32-chars

# ── AI / LLM (choose one) ────────────────────────────────────────────────────
# Option A: Google Gemini (recommended)
GEMINI_API_KEY=your-google-ai-studio-key
GEMINI_MODEL=gemini-2.0-flash

# Option B: OpenAI-compatible (GPT, Ollama, etc.)
# LLM_API_KEY=your-openai-key
# LLM_API_URL=https://api.openai.com/v1/chat/completions
# LLM_MODEL=gpt-4o-mini

# ── Email notifications (optional) ───────────────────────────────────────────
# SMTP_HOST=smtp.sendgrid.net
# SMTP_USER=apikey
# SMTP_PASS=your-sendgrid-api-key
# SMTP_FROM=no-reply@yourdomain.com

# ── Database (optional – defaults to SQLite) ──────────────────────────────────
# DATABASE_URL=postgresql://user:pass@host:5432/claimpilot

# ── Object storage (optional – defaults to local disk) ───────────────────────
# S3_BUCKET=claimpilot-documents
# S3_REGION=ap-south-1
# AWS_ACCESS_KEY_ID=your-key
# AWS_SECRET_ACCESS_KEY=your-secret
